{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-e2e-poc",
  "version": "0.1.0",
  "identifier": "dev.agentpoc.e2e",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent E2E PoC",
        "width": 900,
        "height": 700,
        "resizable": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
