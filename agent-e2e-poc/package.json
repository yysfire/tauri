{
  "name": "agent-e2e-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:web": "vite build --mode wdio",
    "build:app": "cargo build --manifest-path src-tauri/Cargo.toml --features wdio",
    "build": "npm run build:web && npm run build:app",
    "test:e2e": "wdio run wdio.conf.js",
    "agent": "node agent/run.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@wdio/tauri-plugin": "^1.5.1"
  },
  "devDependencies": {
    "@wdio/cli": "^9.32.0",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-service": "^1.5.1",
    "vite": "^7.0.0"
  }
}
